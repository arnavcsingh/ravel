{
  "name": "ravel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A causal concurrency debugger for coding agents.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node scripts/python.mjs serve",
    "demo": "pnpm build && pnpm start",
    "demo:reset": "node scripts/python.mjs reset",
    "dev": "node scripts/python.mjs dev",
    "test": "node scripts/python.mjs test",
    "test:ui": "vitest run --configLoader runner",
    "test:race": "node scripts/python.mjs test:race",
    "test:watch": "vitest --configLoader runner",
    "benchmark": "node scripts/python.mjs benchmark",
    "benchmark:upstream": "node scripts/python.mjs upstream",
    "gemini": "node scripts/python.mjs gemini",
    "inspector": "node scripts/python.mjs inspector",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm format:check",
    "format": "prettier --write packages apps tests scripts examples integrations *.json *.yaml *.ts README.md",
    "format:check": "prettier --check packages apps tests scripts examples integrations *.json *.yaml *.ts README.md",
    "build:runtime": "node scripts/python.mjs build",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts --configLoader runner && pnpm build:runtime"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
