# Ravel runs locally without external API keys.
PORT=4317
RAVEL_DATA_DIR=.ravel/v3

# Gemini - optional Python integration; invoked explicitly with pnpm gemini.
GEMINI_API_KEY=
RAVEL_AGENT_MODEL=gemini-3.5-flash-lite
RAVEL_SEMANTIC_MODEL=gemini-3.5-flash-lite

# Fetch - optional
AGENTVERSE_AGENT_URI=
RAVEL_API_BASE=http://localhost:4317
# Optional ASI:One API testing; the mailbox SDK uses AGENTVERSE_AGENT_URI.
ASI_ONE_API_KEY=

# SpacetimeDB - optional disposable debugger read model. Uses spacetime login.
RAVEL_SPACETIME_ENABLED=false
RAVEL_SPACETIME_URI=https://maincloud.spacetimedb.com
RAVEL_SPACETIME_DATABASE=ravel-mhacks-2026
# RAVEL_SPACETIME_CLI=absolute/path/to/spacetime
