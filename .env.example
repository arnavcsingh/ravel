# Ravel runs locally without external API keys.
PORT=4317
RAVEL_DATA_DIR=.ravel/v2

# Gemini - optional; disabled until its adapter is configured.
GEMINI_API_KEY=
RAVEL_AGENT_MODEL=
RAVEL_SEMANTIC_MODEL=

# SpacetimeDB - optional
RAVEL_SPACETIME_ENABLED=false
RAVEL_SPACETIME_URI=
RAVEL_SPACETIME_DATABASE=

# Fetch - optional
ASI_ONE_API_KEY=
